#!/bin/sh /etc/rc.common

START=91
STOP=09
USE_PROCD=1

start_service() {
	# OpenWrt starts services automatically during package installation.
	if [ "$pkgname" = "reticulum" ]; then
		[ "$PKG_UPGRADE" = "1" ] && enabled || return 0
	fi

	procd_open_instance
	procd_set_param command /usr/bin/rnsh -l --config /root/.rnsh --rnsconfig /root/.reticulum
	procd_set_param env HOME=/root
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /root/.reticulum/config /root/.rnsh/allowed_identities
	procd_close_instance
}
